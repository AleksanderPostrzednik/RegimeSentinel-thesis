{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regimesentinel.local/contracts/monitoring-result.v1.schema.json",
  "title": "RegimeSentinel monitoring-v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolId", "runId", "generatedAtUtc", "state", "dataWindow", "freshness", "modelPolicy", "instruments", "provenance"],
  "properties": {
    "schemaVersion": {"const": "monitoring-result.v1"},
    "protocolId": {"const": "monitoring-v1"},
    "runId": {
      "type": "string",
      "pattern": "^monitoring-v1-[0-9]{8}T[0-9]{6}Z$"
    },
    "generatedAtUtc": {"type": "string", "minLength": 20},
    "state": {"const": "complete"},
    "dataWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedStartUtc", "observedEndUtc", "rowCount", "snapshotSha256"],
      "properties": {
        "observedStartUtc": {"type": "string", "minLength": 10},
        "observedEndUtc": {"type": "string", "minLength": 10},
        "rowCount": {"type": "integer", "minimum": 501},
        "snapshotSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluatedAtUtc", "lastCompleteDayUtc", "observationDateUtc", "observationCompletedAtUtc", "ageDays", "ageHours", "maximumAgeHoursAfterObservationClose", "staleAfterUtc"],
      "properties": {
        "status": {"const": "fresh"},
        "evaluatedAtUtc": {"type": "string", "minLength": 20},
        "lastCompleteDayUtc": {"type": "string", "minLength": 10},
        "observationDateUtc": {"type": "string", "minLength": 10},
        "observationCompletedAtUtc": {"type": "string", "minLength": 20},
        "ageDays": {"type": "integer", "minimum": 0},
        "ageHours": {"type": "number", "minimum": 0},
        "maximumAgeHoursAfterObservationClose": {"type": "integer", "minimum": 24},
        "staleAfterUtc": {"type": "string", "minLength": 20}
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trueMsgarchAttempted", "regimeModelLabel", "winningModelSelected"],
      "properties": {
        "trueMsgarchAttempted": {"const": false},
        "regimeModelLabel": {"const": "fallback_not_ms_garch"},
        "winningModelSelected": {"const": false}
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/instrument"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "riskPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "var", "es"],
      "properties": {
        "confidence": {"type": "number"},
        "var": {"type": "number"},
        "es": {"type": "number"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceModelId", "unit", "levels"],
      "properties": {
        "sourceModelId": {"type": "string", "minLength": 1},
        "unit": {"const": "percent_return"},
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0.95", "0.99"],
          "properties": {
            "0.95": {"$ref": "#/$defs/riskPoint"},
            "0.99": {"$ref": "#/$defs/riskPoint"}
          }
        }
      }
    },
    "baselineFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "modelLabel", "status", "innovation", "convergenceFlag", "logLikelihood", "aic", "bic", "parameters", "forecastVolatilityPercent", "risk"],
      "properties": {
        "modelId": {"enum": ["garch11-studentt", "garch11-normal"]},
        "modelLabel": {"const": "GARCH(1,1)"},
        "status": {"const": "fit_success"},
        "innovation": {"enum": ["student_t", "normal"]},
        "convergenceFlag": {"const": 0},
        "logLikelihood": {"type": "number"},
        "aic": {"type": "number"},
        "bic": {"type": "number"},
        "parameters": {"type": "object"},
        "forecastVolatilityPercent": {"type": "number", "exclusiveMinimum": 0},
        "risk": {"$ref": "#/$defs/risk"}
      }
    },
    "regime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "modelLabel", "status", "fallbackReason", "probabilityType", "selectedRegime", "state", "probability", "filteredProbabilities", "oneStepProbabilities", "forecastVolatilityPercent", "risk", "fit"],
      "properties": {
        "modelId": {"const": "markov-variance-2state"},
        "modelLabel": {"const": "fallback_not_ms_garch"},
        "status": {"const": "fit_success"},
        "fallbackReason": {"const": "operational_protocol_does_not_attempt_true_ms_garch"},
        "probabilityType": {"const": "filtered"},
        "selectedRegime": {"type": "integer", "minimum": 1, "maximum": 2},
        "state": {"enum": ["lower_variance", "higher_variance"]},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "filteredProbabilities": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "oneStepProbabilities": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "forecastVolatilityPercent": {"type": "number", "exclusiveMinimum": 0},
        "risk": {"$ref": "#/$defs/risk"},
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logLikelihood", "variances", "transitionMatrix", "occupancy", "parameters"],
          "properties": {
            "logLikelihood": {"type": "number"},
            "variances": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
            "transitionMatrix": {"type": "array", "minItems": 2, "maxItems": 2},
            "occupancy": {"type": "array", "minItems": 2, "maxItems": 2},
            "parameters": {"type": "object"}
          }
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "currentPrice", "observationDateUtc", "fitStatus", "modelLabel", "volatility", "risk", "baselineFits", "regime"],
      "properties": {
        "instrument": {"enum": ["BTC-USD", "ETH-USD"]},
        "currentPrice": {"type": "number", "exclusiveMinimum": 0},
        "observationDateUtc": {"type": "string", "minLength": 10},
        "fitStatus": {"const": "complete"},
        "modelLabel": {"const": "fallback_not_ms_garch"},
        "volatility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceModelId", "unit", "forecastPercent"],
          "properties": {
            "sourceModelId": {"const": "garch11-studentt"},
            "unit": {"const": "percent_return"},
            "forecastPercent": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "risk": {"$ref": "#/$defs/risk"},
        "baselineFits": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/baselineFit"}},
        "regime": {"$ref": "#/$defs/regime"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataKind", "provider", "accessMethod", "sourceUrls", "priceField", "retrievedAtUtc", "snapshotId", "snapshotFileSha256", "snapshotContentSha256", "protocolSha256", "codeCommit", "runtimeVersions"],
      "properties": {
        "dataKind": {"const": "real"},
        "provider": {"const": "Yahoo Finance"},
        "accessMethod": {"const": "yfinance 0.2.65"},
        "sourceUrls": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "priceField": {"const": "unadjusted_close"},
        "retrievedAtUtc": {"type": "string", "minLength": 20},
        "snapshotId": {"type": "string", "minLength": 1},
        "snapshotFileSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshotContentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "protocolSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "codeCommit": {"type": "string", "minLength": 1},
        "runtimeVersions": {"type": "object"}
      }
    }
  }
}
